# Define the name for our virtual environment
VENV_NAME="avalanche-chain-tools-3.13.9"

# Use pyenv to resolve the venv name to its full path.
VENV_PATH=$(pyenv prefix "$VENV_NAME")

# If the venv doesn't exist, give the user a helpful hint.
if [[ -z "$VENV_PATH" ]]; then
    echo "❌ Virtualenv '$VENV_NAME' not found."
    echo "💡 Please create it. This project requires a specific Python version."
    echo "   First, find the required version in the project documentation or .python-version file."
    echo "   Then run: pyenv virtualenv <python-version> $VENV_NAME"
    echo ""
    exit 1
fi

# Add the venv's bin directory to the front of the PATH
PATH_add "$VENV_PATH/bin"

# Export the VIRTUAL_ENV variable so prompts and tools work correctly
export VIRTUAL_ENV="$VENV_PATH"

# Set VIRTUAL_ENV_PROMPT for bash PS1 (pyenv-virtualenv hook doesn't run with direnv)
export VIRTUAL_ENV_PROMPT="($VENV_NAME)"

# For extra clarity, let's also find and export the actual Python version being used.
PYTHON_VERSION=$("$VENV_PATH/bin/python" --version 2>&1 | cut -d' ' -f2)
export PYTHON_VERSION
