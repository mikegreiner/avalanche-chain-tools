{
  "manifest_version": 3,
  "name": "Blackhole DEX Tools",
  "version": "1.0.1",
  "description": "Enhanced tools for Blackhole DEX voting: pool recommendations, tracking, and analysis",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://blackhole.xyz/*",
    "https://resources.blackhole.xyz/*",
    "https://api.snowtrace.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://blackhole.xyz/vote*"],
      "js": ["content-bundle.js"],
      "run_at": "document_idle",
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*.js"],
      "matches": ["https://blackhole.xyz/*"]
    }
  ]
}
